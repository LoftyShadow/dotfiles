# 解决 nvim 按 Esc 键的延迟
set -s escape-time 0

# 提高滚屏历史，方便回看 Codex、CI、SSH 排查输出
set -g history-limit 50000

# 开启鼠标支持（方便你用鼠标调整分屏大小）
set -g mouse on
set -g focus-events on
# 不接受程序通过转义序列覆盖手工/hook 设置的 window 名称
set -g allow-rename off
# 当销毁会话时，优先切到上一个 session
set -g detach-on-destroy previous
# 开启窗口编号自动重新排序
set -g renumber-windows on

# 开启 copy-mode 的 vi 模式
setw -g mode-keys vi

# 类似 vim 的选中文本
bind-key -T copy-mode-vi v send-keys -X begin-selection
# 类似 vim 的复制文本到剪贴板
{{ if eq .chezmoi.os "darwin" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
{{ else }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "wl-copy"
{{ end }}

# 修改前缀键为 Ctrl+a
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# 使用更直观的分割快捷键
bind | split-window -h -c "#{pane_current_path}" # 竖分屏保持当前路径
bind - split-window -v -c "#{pane_current_path}" # 横分屏保持当前路径

# 使用vim风格的窗格切换
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
# 使用vim风格调整窗格大小
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
# 按 Prefix + N 直接创建新会话 (不询问名字，快速开启)
bind N new-session

# 快速创建新会话（会提示你输入名称）
unbind C
bind C command-prompt -p "Session Name:" "new-session -s '%%'"

# tmux 配置/自定义界面
bind-key C-c customize-mode -Z
# 新建 window 时提示命名，默认填当前目录名
unbind c
bind c command-prompt -I "#{b:pane_current_path}" -p "Window Name:" "new-window -c '#{pane_current_path}' -n '%%'"
# 关闭当前会话，切换逻辑交给 tmux 原生处理
bind-key Q kill-session

# Popup 工作流
bind G display-popup -E -b rounded -S "fg=colour31" -w 92% -h 88% -d "#{pane_current_path}" -T " lazygit " "lazygit"
bind B display-popup -E -b rounded -S "fg=colour31" -w 88% -h 78% -d "#{pane_current_path}" -T " btop " "btop"
unbind T

# chooser
bind s choose-tree -Zs -y
bind w choose-tree -Zw -y
bind f display-popup -E -b rounded -S "fg=colour31" -w 82% -h 72% -T " windows " "tmux-fzf-window"
bind Space last-window
bind Tab switch-client -n
bind-key BTab switch-client -p

# 文件浏览 popup
bind y display-popup -E -b rounded -S "fg=colour31" -w 92% -h 88% -d "#{pane_current_path}" -T " yazi " "yazi"

# 快速重载配置文件
bind r source-file ~/.tmux.conf \; display-message "Config reloaded!"
bind x kill-pane
bind & kill-window

# 设置状态栏样式
set -g status-position top
set -g status-interval 5
set -g status-left-length 32
set -g status-right-length 32
set -g status-style "bg=#45475A,fg=#e3e5e5"
set -g status-left '#[fg=#a3aed2,bg=#45475A]#[fg=#090c0c,bold,bg=#a3aed2] #S #[fg=#a3aed2,bg=#45475A] '
set -g status-right '#[fg=#a0a9cb,bg=#45475A]  %m-%d   %H:%M '

# 让不同 window 的区分更明显，但保持整体风格克制
set -g window-status-separator " "
set -g window-status-format '#[fg=#a3aed2,bg=#45475A] #I #[fg=#e3e5e5,bg=#45475A]#W#{?@codex_status, · #{@codex_status},} '
set -g window-status-current-format '#[fg=#769FF0,bg=#45475A]#[fg=#090c0c,bold,bg=#769FF0] #I #[fg=#1d2230,bold,bg=#769FF0]#W#{?@codex_status, · #{@codex_status},} #[fg=#769FF0,bg=#45475A]'
set -g window-status-activity-style 'fg=#a0a9cb,bg=#45475A,bold'
set -g window-status-bell-style 'fg=colour255,bg=colour124,bold'
setw -g monitor-activity on
set -g visual-activity off
set -g activity-action other

# 当前 pane 用更清晰的边框色，避免分屏时看混
set -g pane-border-style 'fg=colour238'
set -g pane-active-border-style 'fg=colour31'
set -g pane-border-status top
set -g pane-border-format ''
# 解决 nvim 在 tmux 中的颜色显示问题
# set -g default-terminal "alacritty"
# set -as terminal-overrides ",alacritty:Tc"
# set -g default-terminal "ghostty"
# set -as terminal-overrides ",ghostty:Tc"
set -g default-terminal "tmux-256color"
set -as terminal-overrides ",ghostty:Tc,alacritty:Tc"

# --- 插件管理 (核心：自动恢复) ---
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'   # 保存/恢复
set -g @plugin 'tmux-plugins/tmux-continuum'   # 自动保存/自动恢复

# --- 插件进阶设置 ---
set -g @resurrect-strategy-nvim 'session'      # 完美恢复 nvim 会话状态
set -g @resurrect-capture-pane-contents 'on'   # 恢复窗格里的文字内容
set -g @resurrect-processes '"~codex.js->codex-resurrect *" ssh'
set -g @continuum-restore 'on'                 # 启动 tmux 时自动执行 restore
set -g @continuum-save-interval '15'           # 每 15 分钟自动保存一次
set -g @plugin 'tmux-plugins/tmux-yank'        # 更完美地处理系统剪贴板，尤其是支持鼠标选中的瞬间自动复制。

# 初始化 TPM (必须在最后)；新机器尚未安装时不要让配置重载报错
if-shell 'test -x "$HOME/.tmux/plugins/tpm/tpm"' 'run-shell "$HOME/.tmux/plugins/tpm/tpm"'
