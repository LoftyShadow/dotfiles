#!/usr/bin/env bash

set -euo pipefail

roots=(
  "$HOME/IdeaProjects"
  "$HOME/PycharmProjects"
  "$HOME/GolandProjects"
  "$HOME/RustroverProjects"
  "$HOME/GodotProjects"
  "$HOME/dyad-apps"
  "$HOME/RemoteServer"
  "$HOME/Documents"
)

if [[ $# -gt 0 ]]; then
  selected="$*"
else
  candidates=()
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] || continue

    while IFS= read -r dir; do
      candidates+=("$dir")
    done < <(
      fd . "$root" \
        --max-depth 2 \
        --min-depth 1 \
        --type d \
        --hidden \
        --exclude .git \
        --exclude .idea \
        --exclude .vscode \
        --exclude .venv \
        --exclude node_modules \
        --exclude target \
        --exclude dist \
        --exclude build \
        --exclude __pycache__ \
        --exclude .pytest_cache \
        --exclude .ruff_cache
    )
  done

  selected="$(
    printf '%s\n' "${candidates[@]}" \
      | awk '!seen[$0]++' \
      | fzf --height=70% --layout=reverse --border --prompt='project > '
  )"
fi

[[ -n "${selected:-}" ]] || exit 0

selected="${selected%/}"
session_name="$(basename "$selected" | tr '. ' '__')"

if [[ -n "${TMUX:-}" ]]; then
  if tmux has-session -t="$session_name" 2>/dev/null; then
    exec tmux switch-client -t "$session_name"
  else
    exec tmux new-session -ds "$session_name" -c "$selected" \; switch-client -t "$session_name"
  fi
else
  if tmux has-session -t="$session_name" 2>/dev/null; then
    exec tmux attach-session -t "$session_name"
  else
    exec tmux new-session -s "$session_name" -c "$selected"
  fi
fi
