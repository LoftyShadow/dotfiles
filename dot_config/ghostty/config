# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# --- 基础显示 ---
font-family = "JetBrains Maple Mono"
font-size = 13
font-thicken = true

# 开启连字（写 Java 时的 !=, ->, == 等会更美观）
font-feature = ss01
font-feature = ss02

# 平铺 WM 下交给窗口管理器决定尺寸
window-width = 0
window-height = 0

# 滚动缓冲上限
scrollback-limit = 100000

# --- 主题与透明度 ---
# Ghostty 内置了大量主题，可以用 ghostty +list-themes 查看
theme = "Catppuccin Mocha"
background-opacity = 0.86
# background-blur-radius = 24  # 暂时禁用：与 custom-shader 组合在 niri 下导致渲染失败
minimum-contrast = 1.1

# --- 窗口样式 ---
# 平铺布局更干净，去掉标题栏并增加内边距
window-decoration = false
window-save-state = default
window-padding-x = 8
window-padding-y = 6

# --- 鼠标与光标 ---
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
# shell-integration-features = no-cursor  # 与 custom-shader 冲突，着色器需要光标位置信息

# --- 其他优化 ---
# 复制到系统剪贴板
copy-on-select = true
confirm-close-surface = false

# 多窗口独立运行（解决 shader 多窗口渲染问题）
gtk-single-instance = false

# --- Quick Terminal ---
# 保留应用内唤起，不再占用 F12 全局热键
keybind = ctrl+shift+space=toggle_quick_terminal
quick-terminal-position = bottom
quick-terminal-size = 34%
gtk-quick-terminal-layer = overlay
quick-terminal-autohide = true

# --- 光标移动动画 ---
# 使用内置动画（兼容 niri/Wayland）
cursor-style-blink = true

# Neovide 风格光标拖尾特效（Wayland 下可能有性能或渲染问题）
custom-shader = /home/niemingzhi/.config/ghostty/shaders/cursor-motion.glsl
custom-shader-animation = true
