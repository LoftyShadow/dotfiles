# 如果不是在 tmux 里，且当前是交互式 Shell，则尝试进入 tmux
# 第一个终端进 default session（持久化），后续终端用临时独立 session
if [[ -z "$TMUX" && $- == *i* ]]; then
    if tmux has-session -t default 2>/dev/null; then
        exec tmux new-session -s "term-$$" \; set destroy-unattached on
    else
        exec tmux new-session -s default
    fi
fi

